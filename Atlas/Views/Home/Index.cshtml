@{
    ViewData["Title"] = "Plan Your Next Adventure";
}

<!-- Hero Section -->
<section class="container-fluid px-0">
    <div class="position-relative overflow-hidden"
         style="min-height: 570px; background: linear-gradient(90deg, rgba(20,25,30,.75), rgba(20,25,30,.15)), url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=85') center/cover;">

        <div class="container py-5">
            <div class="row align-items-center" style="min-height: 470px;">
                <div class="col-lg-7 text-white py-5">

                    <span class="badge rounded-pill px-3 py-2 mb-4"
                          style="background:#F47769;">
                        YOUR JOURNEY STARTS HERE
                    </span>

                    <h1 class="display-2 fw-bold mb-4">
                        Good trips start
                        <br />
                        <span style="color:#FF9B8D;">together.</span>
                    </h1>

                    <p class="fs-5 mb-4" style="max-width:550px;">
                        Bring your friends together, plan your next adventure,
                        agree on costs and make every trip unforgettable.
                    </p>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="#start-trip"
                           class="btn btn-lg text-white px-4 py-3 fw-semibold"
                           style="background:#F47769; border-radius:10px;">
                            Start a trip
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <a href="#how-it-works"
                           class="btn btn-lg btn-outline-light px-4 py-3"
                           style="border-radius:10px;">
                            How Atlas works
                        </a>
                    </div>

                    <div class="mt-5 d-flex align-items-center gap-3">
                        <i class="bi bi-people-fill fs-3"
                           style="color:#FF9B8D;"></i>
                        <span class="small">
                            Plan together. Commit together. Travel together.
                        </span>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Start Planning Section -->
<section id="start-trip" class="py-5" style="background:#FFF9F6;">
    <div class="container py-4">

        <div class="text-center mb-5">
            <span class="text-uppercase fw-semibold small"
                  style="color:#F47769; letter-spacing:2px;">
                MAKE IT HAPPEN
            </span>

            <h2 class="display-6 fw-bold mt-2">
                Where do you want to go?
            </h2>

            <p class="text-muted">
                Start with an idea. Atlas helps you turn it into a real trip.
            </p>
        </div>

        <div class="row g-4 justify-content-center">

            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 p-lg-5">

                        <div class="mb-4">
                            <div class="rounded-3 d-inline-flex p-3"
                                 style="background:#FFF0EC; color:#F47769;">
                                <i class="bi bi-plus-circle fs-2"></i>
                            </div>
                        </div>

                        <h3 class="fw-bold">Create a new trip</h3>

                        <p class="text-muted">
                            Have a destination in mind? Start from scratch,
                            choose your dates and invite your friends.
                        </p>

                        <a href="#"
                           class="btn text-white mt-3 px-4"
                           style="background:#F47769;">
                            Create a trip
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 p-lg-5">

                        <div class="mb-4">
                            <div class="rounded-3 d-inline-flex p-3"
                                 style="background:#FFF0EC; color:#F47769;">
                                <i class="bi bi-compass fs-2"></i>
                            </div>
                        </div>

                        <h3 class="fw-bold">Start with inspiration</h3>

                        <p class="text-muted">
                            Explore curated destinations, events and ready-made
                            trip ideas to inspire your next adventure.
                        </p>

                        <a href="#destinations"
                           class="btn btn-outline-dark mt-3 px-4">
                            Explore ideas
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Popular Destinations -->
<section id="destinations" class="py-5">
    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase fw-semibold small"
                      style="color:#F47769; letter-spacing:2px;">
                    FIND YOUR NEXT ADVENTURE
                </span>

                <h2 class="fw-bold mt-2">Travel inspiration</h2>

                <p class="text-muted mb-0">
                    Some ideas to get your group dreaming.
                </p>
            </div>
        </div>

        <div class="row g-4">

            <!-- Cape Town -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">

                    <img src="https://images.unsplash.com/photo-1580060839134-75a5edca2e99?auto=format&fit=crop&w=900&q=85"
                         class="card-img-top"
                         alt="Cape Town"
                         style="height:240px; object-fit:cover;" />

                    <div class="card-body p-4">
                        <span class="small text-muted">
                            WESTERN CAPE
                        </span>

                        <h4 class="fw-bold mt-2">Cape Town</h4>

                        <p class="text-muted">
                            Mountains, beaches, food and unforgettable views.
                        </p>

                        <a href="#" class="text-decoration-none fw-semibold"
                           style="color:#F47769;">
                            Explore trip idea
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                </div>
            </div>

            <!-- Kruger National Park -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">

                    <img src="https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=900&q=85"
                         class="card-img-top"
                         alt="African safari"
                         style="height:240px; object-fit:cover;" />

                    <div class="card-body p-4">
                        <span class="small text-muted">
                            MPUMALANGA
                        </span>

                        <h4 class="fw-bold mt-2">Kruger Safari</h4>

                        <p class="text-muted">
                            Experience African wildlife and the beauty of nature.
                        </p>

                        <a href="#" class="text-decoration-none fw-semibold"
                           style="color:#F47769;">
                            Explore trip idea
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                </div>
            </div>

            <!-- Durban -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">

                    <img src="https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=900&q=85"
                         class="card-img-top"
                         alt="Beach holiday"
                         style="height:240px; object-fit:cover;" />

                    <div class="card-body p-4">
                        <span class="small text-muted">
                            KWAZULU-NATAL
                        </span>

                        <h4 class="fw-bold mt-2">Durban</h4>

                        <p class="text-muted">
                            Sunny beaches, coastal experiences and great food.
                        </p>

                        <a href="#" class="text-decoration-none fw-semibold"
                           style="color:#F47769;">
                            Explore trip idea
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- How Atlas Works -->
<section id="how-it-works" class="py-5" style="background:#FFF9F6;">
    <div class="container py-5">

        <div class="text-center mb-5">
            <span class="text-uppercase fw-semibold small"
                  style="color:#F47769; letter-spacing:2px;">
                SIMPLE BY DESIGN
            </span>

            <h2 class="display-6 fw-bold mt-2">
                From group chat to great trip.
            </h2>

            <p class="text-muted">
                Everything your group needs to organise an adventure.
            </p>
        </div>

        <div class="row g-4 text-center">

            <div class="col-md-3">
                <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                    <i class="bi bi-map fs-1"
                       style="color:#F47769;"></i>

                    <h5 class="fw-bold mt-3">1. Plan</h5>

                    <p class="text-muted small mb-0">
                        Create your trip, choose dates and organise activities.
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                    <i class="bi bi-people fs-1"
                       style="color:#F47769;"></i>

                    <h5 class="fw-bold mt-3">2. Invite</h5>

                    <p class="text-muted small mb-0">
                        Share your trip with friends and collect their replies.
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                    <i class="bi bi-check2-circle fs-1"
                       style="color:#F47769;"></i>

                    <h5 class="fw-bold mt-3">3. Commit</h5>

                    <p class="text-muted small mb-0">
                        Agree on costs and record everyone's commitments.
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                    <i class="bi bi-airplane fs-1"
                       style="color:#F47769;"></i>

                    <h5 class="fw-bold mt-3">4. Travel</h5>

                    <p class="text-muted small mb-0">
                        Keep your plans organised and enjoy the experience.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Final Call to Action -->
<section class="py-5">
    <div class="container py-4">

        <div class="rounded-4 p-5 text-center text-white"
             style="background:#27343B;">

            <h2 class="display-6 fw-bold">
                Your next adventure is waiting.
            </h2>

            <p class="fs-5 mt-3 mb-4" style="color:#E5E7EB;">
                Bring your friends together and make the plan happen.
            </p>

            <a href="#start-trip"
               class="btn btn-lg text-white px-5 py-3 fw-semibold"
               style="background:#F47769; border-radius:10px;">
                Start planning
                <i class="bi bi-arrow-right ms-2"></i>
            </a>

        </div>

    </div>
</section>
